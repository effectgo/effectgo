# Stub rules for github.com/go-fuego/fuego v0.20.0 (module cache copy).
#
# Body() is the method of the Context interface. ContextWithBody[B] and
# ContextNoBody are aliases of Context[B, any] and Context[any, any]; a rule on
# either resolves to the origin method, so this one rule covers all three.
#
# Evidence (paths relative to fuego@v0.20.0):
#   ctx.go:357-364     netHttpContext.Body caches and returns body(*c)
#   ctx.go:546-599     body(): every return path of the content-type switch
#   ctx.go:560-568     user-registered content-type SerDes (OptionWithContentTypeSerDes):
#                      Deserialize error returned raw (ctx.go:562); type mismatch is
#                      fmt.Errorf (ctx.go:566)                                  -> ?
#   ctx.go:584-586     application/octet-stream: io.ReadAll error returned raw   -> ?
#   ctx.go:590         application/octet-stream: fmt.Errorf (wrong body type)    -> ?
#   ctx.go:570-578     text/plain (readString), form (readURLEncoded), xml, yaml, json:
#   deserialization.go:99   read(): decode failure -> BadRequestError           (json/xml/yaml)
#   deserialization.go:121  readString(): read failure -> BadRequestError       (text/plain)
#   deserialization.go:170  readURLEncoded(): fmt.Errorf("cannot parse form: %w") -> ?
#   deserialization.go:178  readURLEncoded(): decode failure -> BadRequestError (form)
#   deserialization.go:196  transform(): InTransform failure -> BadRequestError
#   deserialization.go:213-221 TransformAndValidate: transform, then validate
#   validation.go:48   validate(): fmt.Errorf("validation error: %w") when the
#                      validator itself fails (InvalidValidationError)           -> ?
#   validation.go:51-74 validate(): a field validation failure returns the
#                      HTTPError VALUE (Status 400, Title "Validation Error")  -> type:HTTPError
#
# So the body path returns BadRequestError, HTTPError, and unclassified errors
# (user SerDes, form/octet-stream wrapping and raw read errors, validator
# misuse). The unclassified part is declared as "?" and is not hidden.
errors (github.com/go-fuego/fuego.ContextWithBody).Body type:github.com/go-fuego/fuego.BadRequestError,type:github.com/go-fuego/fuego.HTTPError,?
## ---- status rules (errset, fallback) -------------------------------------
# A status line gives the HTTP status of an error type when its StatusCode()
# method is not read (errset/status.go). Inference from the method body comes
# first, so these lines matter only where fuego's facts are not available.
# Each constant is from fuego v0.20.0 errors.go, one "StatusCode() int" body
# that returns a constant (the line numbers are of those bodies).
#
# fuego.HTTPError is NOT listed: its StatusCode (errors.go:90-95) returns 500
# when Status is 0 and Status otherwise, so its status depends on the value.
# It is unknown, and the OpenAPI output documents it as "default".
status (github.com/go-fuego/fuego.BadRequestError) 400       # errors.go:115
status (github.com/go-fuego/fuego.NotFoundError) 404         # errors.go:129
status (github.com/go-fuego/fuego.UnauthorizedError) 401     # errors.go:143
status (github.com/go-fuego/fuego.ForbiddenError) 403        # errors.go:157
status (github.com/go-fuego/fuego.ConflictError) 409         # errors.go:171
status (github.com/go-fuego/fuego.NotAcceptableError) 406    # errors.go:188
status (github.com/go-fuego/fuego.PathParamNotFoundError) 422       # ctx.go:268
status (github.com/go-fuego/fuego.PathParamInvalidTypeError) 422    # ctx.go:285
## ---- route rules (openapi) ------------------------------------------------
# A route rule names a registration function, its method, and the 0-based
# indexes of its path and handler arguments (openapi/openapi.go). Fuego's
# route functions take (s *Server, path string, controller, options...)
# (net_http_mux.go:50-68): the path is argument 1 and the handler is argument 2.
# The functions are generic; the rule names the origin, which matches every
# instantiation.
route github.com/go-fuego/fuego.Get GET 1 2       # net_http_mux.go:50
route github.com/go-fuego/fuego.Post POST 1 2     # net_http_mux.go:54
route github.com/go-fuego/fuego.Delete DELETE 1 2 # net_http_mux.go:58
route github.com/go-fuego/fuego.Put PUT 1 2       # net_http_mux.go:62
route github.com/go-fuego/fuego.Patch PATCH 1 2   # net_http_mux.go:66
