route github.com/danielgtaylor/huma/v2.Delete DELETE 1 2 # huma.go:2383
route github.com/danielgtaylor/huma/v2.Register @1.Method @1.Path 2   # huma.go:708

errdefault github.com/danielgtaylor/huma/v2 passthrough=iface:github.com/danielgtaylor/huma/v2.StatusError,fallback=500   # huma.go:1094-1106
