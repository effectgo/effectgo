status github.com/danielgtaylor/huma/v2.NewErrorWithContext arg:1   # error.go:251 (var; the status follows the Context)

route github.com/danielgtaylor/huma/v2.Get GET 1 2       # huma.go:2281
route github.com/danielgtaylor/huma/v2.Post POST 1 2     # huma.go:2302
route github.com/danielgtaylor/huma/v2.Put PUT 1 2       # huma.go:2343
